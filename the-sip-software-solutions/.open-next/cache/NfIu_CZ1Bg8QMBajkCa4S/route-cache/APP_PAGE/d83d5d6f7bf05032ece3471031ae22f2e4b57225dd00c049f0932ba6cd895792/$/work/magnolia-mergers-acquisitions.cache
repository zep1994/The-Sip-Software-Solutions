{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/work/layout,_N_T_/work/magnolia-mergers-acquisitions/layout,_N_T_/work/magnolia-mergers-acquisitions/page,_N_T_/work/magnolia-mergers-acquisitions"},"segmentPaths":["/_tree","/_full","/work/magnolia-mergers-acquisitions/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/d83d5d6f7bf05032ece3471031ae22f2e4b57225dd00c049f0932ba6cd895792/$/work/magnolia-mergers-acquisitions","owner":{"kind":"APP_PAGE","sourceRoute":"/work/magnolia-mergers-acquisitions/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(max-width:1200px) 90vw, 1100px\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2cxb684axw7o7.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/19mx3mg6lkumu.js\" async=\"\"></script><script src=\"/_next/static/chunks/3g4px251sg85e.js\" async=\"\"></script><script src=\"/_next/static/chunks/2z-e6jheq0ftu.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-03rfayxv7ep_b.js\" async=\"\"></script><script src=\"/_next/static/chunks/3jnihsg-rcdh1.js\" async=\"\"></script><script src=\"/_next/static/chunks/2rp0_txwy34_u.js\" async=\"\"></script><title>Magnolia Mergers &amp; Acquisitions Website Case Study | The Sip Web Studio</title><meta name=\"description\" content=\"Explore The Sip Web Studio’s website design for Magnolia Mergers &amp; Acquisitions: a professional Mississippi advisory website with clear services and a guided client journey.\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://thesipwebstudio.com/work/magnolia-mergers-acquisitions\"/><meta property=\"og:title\" content=\"Magnolia Mergers &amp; Acquisitions | Website Case Study\"/><meta property=\"og:description\" content=\"A thoughtful website for a Mississippi M&amp;A advisory firm.\"/><meta property=\"og:url\" content=\"https://thesipwebstudio.com/work/magnolia-mergers-acquisitions\"/><meta property=\"og:image\" content=\"https://thesipwebstudio.com/images/magnolia1.png\"/><meta property=\"og:image:width\" content=\"1822\"/><meta property=\"og:image:height\" content=\"985\"/><meta property=\"og:image:alt\" content=\"Magnolia Mergers and Acquisitions website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"The Sip Web Studio | Jackson, MS Web Design\"/><meta name=\"twitter:description\" content=\"Practical websites and business technology for Mississippi businesses.\"/><meta name=\"twitter:image\" content=\"https://thesipwebstudio.com/social-card.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.1xagt9q099n52.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/studio-icon.svg\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"skip-link\" href=\"#main-content\">Skip to content</a><header class=\"site-header\"><div class=\"wrap nav\"><a class=\"wordmark\" aria-label=\"The Sip Web Studio home\" href=\"/\">the sip<span>WEB STUDIO</span></a><nav aria-label=\"Main navigation\"><a href=\"/services\">Services</a><a href=\"/#portfolio\">Work</a><a href=\"/#about\">About</a><a href=\"/#pricing\">Pricing</a><a class=\"nav-cta\" href=\"/#contact\">Free growth review ↗</a></nav></div></header><main id=\"main-content\" class=\"wrap\"><section class=\"section\"><div class=\"case-hero\"><a class=\"text-link\" href=\"/#portfolio\">← Back to selected work</a><p class=\"eyebrow\" style=\"margin-top:35px\">Case study / Professional services / Mississippi</p><h1>A confident presence for <em>important decisions.</em></h1><p class=\"lead\">Magnolia Mergers &amp; Acquisitions helps business owners navigate sales, acquisitions, valuations, and pre-sale preparation. Its website brings that expertise into a clear, professional first impression.</p><div class=\"case-meta\"><p><strong>Client</strong>Magnolia Mergers &amp; Acquisitions</p><p><strong>Work</strong>Website design &amp; development</p><p><strong>Platform</strong>Cloudflare hosting</p></div><a class=\"button\" href=\"https://magnolia-ma.com\" target=\"_blank\" rel=\"noopener noreferrer\">Visit the client website ↗</a></div></section><div class=\"project-image\"><img alt=\"Magnolia homepage introducing its confidential advisory services against a navy handshake background\" width=\"1822\" height=\"985\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width:1200px) 90vw, 1100px\" srcSet=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75\"/></div><section><article class=\"case-grid\"><h2>The brief</h2><div><p>For an advisory firm involved in significant business decisions, the website needs to communicate credibility and care. Visitors should be able to understand the firm’s services, learn how a transaction progresses, and find a direct path to a confidential consultation.</p><p>The design centers on that visitor journey, with a professional visual identity and a clear explanation of Magnolia’s work serving Mississippi and the Southeast.</p></div></article><article class=\"case-grid\"><h2>The approach</h2><div><p>A navy, white, and burgundy palette complements Magnolia’s established branding. Large serif headings give the site an editorial tone, while generous spacing and clear navigation make detailed advisory information easier to scan.</p><p>The homepage introduces the firm’s purpose immediately. Four service areas—pre-sale advisory, M&amp;A advisory, business valuation, and buy-side searches—give visitors a useful starting point. The process section then explains the journey from discovery and preparation toward closing.</p></div></article><div class=\"case-gallery\"><figure><img alt=\"Magnolia service section organizing four advisory offerings into readable columns\" loading=\"lazy\" width=\"1825\" height=\"979\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width:750px) 90vw, 550px\" srcSet=\"/_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmagnolia2.png&amp;w=3840&amp;q=75\"/><figcaption>01 / Clear service categories help visitors find the right guidance.</figcaption></figure><figure><img alt=\"Magnolia process section explaining discovery and preparation\" loading=\"lazy\" width=\"1827\" height=\"990\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width:750px) 90vw, 550px\" srcSet=\"/_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmagnolia3.png&amp;w=3840&amp;q=75\"/><figcaption>02 / A step-by-step process makes a complex transaction more approachable.</figcaption></figure></div><article class=\"case-grid\"><h2>The finished work</h2><div><p>A cohesive website that introduces Magnolia’s expertise, organizes its advisory services, and invites visitors to begin a confidential conversation. The completed site gives the firm a professional destination to share with prospective clients.</p><p>This case study describes the delivered design and content. Traffic, lead, and search ranking results have not been measured here.</p></div></article></section><section class=\"quote-section\" style=\"padding:40px;margin-top:50px\"><p class=\"eyebrow\">Client feedback</p><blockquote>“This look fantastic, and certainly exceeded my expectations as well. Thank you, Wes!”</blockquote><p>Charles Word — Magnolia Mergers &amp; Acquisitions</p></section><section class=\"case-cta\"><h2>Let’s bring your business<br/><em>into focus.</em></h2><a class=\"button\" href=\"/#contact\">Talk about your website ↗</a></section><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thesipwebstudio.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Magnolia Mergers & Acquisitions case study\",\"item\":\"https://thesipwebstudio.com/work/magnolia-mergers-acquisitions\"}]}</script></main><!--$--><!--/$--><footer class=\"wrap footer\"><a class=\"wordmark\" href=\"/\">the sip<span>WEB STUDIO</span></a><p>Thoughtfully built in Mississippi.<br/><a href=\"/services\">Explore services</a> · <a href=\"/services/google-business-profile#disclosure\">Google profile disclosure</a></p><p>© <!-- -->2026<!-- --> The Sip Web Studio</p></footer><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://thesipwebstudio.com/#studio\",\"name\":\"The Sip Web Studio\",\"url\":\"https://thesipwebstudio.com\",\"email\":\"thesipsoftwaresolutions@gmail.com\",\"areaServed\":[\"Jackson, Mississippi\",\"Ridgeland, Mississippi\",\"Madison, Mississippi\",\"Flowood, Mississippi\",\"Brandon, Mississippi\",\"Pearl, Mississippi\",\"Clinton, Mississippi\"],\"description\":\"Independent website and business technology studio serving Jackson and Mississippi businesses.\",\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Small business technology services\",\"itemListElement\":[{\"@type\":\"OfferCatalog\",\"name\":\"Web design and development\"},{\"@type\":\"OfferCatalog\",\"name\":\"Local SEO\"},{\"@type\":\"OfferCatalog\",\"name\":\"Website maintenance\"},{\"@type\":\"OfferCatalog\",\"name\":\"Hosting\"},{\"@type\":\"OfferCatalog\",\"name\":\"Google Business Profile op