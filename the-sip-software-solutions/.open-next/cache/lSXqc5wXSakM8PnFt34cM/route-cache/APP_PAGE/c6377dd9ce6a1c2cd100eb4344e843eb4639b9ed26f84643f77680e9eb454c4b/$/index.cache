{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}},"routeCache":{"key":"/route-cache/APP_PAGE/c6377dd9ce6a1c2cd100eb4344e843eb4639b9ed26f84643f77680e9eb454c4b/$/index","owner":{"kind":"APP_PAGE","sourceRoute":"/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(max-width: 850px) 90vw, 48vw\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/24ryyrgauep89.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/19mx3mg6lkumu.js\" async=\"\"></script><script src=\"/_next/static/chunks/3g4px251sg85e.js\" async=\"\"></script><script src=\"/_next/static/chunks/2z-e6jheq0ftu.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-03rfayxv7ep_b.js\" async=\"\"></script><script src=\"/_next/static/chunks/3jnihsg-rcdh1.js\" async=\"\"></script><script src=\"/_next/static/chunks/07dukngfkqf5a.js\" async=\"\"></script><title>Web Developer in Jackson, MS | The Sip Web Studio</title><meta name=\"description\" content=\"Custom web design and development in Jackson, MS. The Sip Web Studio builds professional websites for Mississippi businesses, with local SEO and ongoing website care.\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://thesipwebstudio.com\"/><meta property=\"og:title\" content=\"Web Design with Southern Soul | The Sip Web Studio\"/><meta property=\"og:description\" content=\"Custom websites, local SEO, and personal support for businesses in Jackson, Mississippi.\"/><meta property=\"og:url\" content=\"https://thesipwebstudio.com\"/><meta property=\"og:site_name\" content=\"The Sip Web Studio\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://thesipwebstudio.com/social-card.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"The Sip Web Studio — web design with Southern soul\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"The Sip Web Studio | Jackson, MS Web Design\"/><meta name=\"twitter:description\" content=\"Thoughtful websites for Mississippi businesses.\"/><meta name=\"twitter:image\" content=\"https://thesipwebstudio.com/social-card.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.1xagt9q099n52.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/studio-icon.svg\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"skip-link\" href=\"#main-content\">Skip to content</a><header class=\"site-header\"><div class=\"wrap nav\"><a class=\"wordmark\" aria-label=\"The Sip Web Studio home\" href=\"/\">the sip<span>WEB STUDIO</span></a><nav aria-label=\"Main navigation\"><a href=\"/#services\">Services</a><a href=\"/#portfolio\">Work</a><a href=\"/#about\">About</a><a href=\"/#pricing\">Pricing</a><a class=\"nav-cta\" href=\"/#contact\">Let’s talk ↗</a></nav></div></header><main id=\"main-content\"><section class=\"hero wrap\"><div class=\"hero-copy\"><p class=\"eyebrow\">Independent web studio · Jackson, Mississippi</p><h1>Web design with<br/>a little <em>Southern soul.</em></h1><p class=\"lead\">Your business has a story. Let’s give it a website worth sharing.</p><p>Custom web design, development, and local SEO for businesses in Jackson, MS and across Mississippi. Thoughtfully built. Easy to use. Ready for what’s next.</p><div class=\"actions\"><a class=\"button\" href=\"#contact\">Let’s talk about your website <span>↗</span></a><a class=\"text-link\" href=\"#portfolio\">Explore the work ↓</a></div><div class=\"hero-note\"><span class=\"dot\"></span> Local perspective. Personal attention.</div></div><div class=\"hero-art\" aria-label=\"Featured website project for Magnolia Mergers and Acquisitions\"><div class=\"art-top\"><span>GOOD BUSINESS. GREAT WEBSITES.</span><span>EST. IN THE SIP</span></div><div class=\"browser-frame\"><div class=\"browser-bar\"><span>● ● ●</span><span>magnolia-ma.com</span><span>↗</span></div><img alt=\"Magnolia Mergers and Acquisitions website with navy branding and a clear advisory headline\" width=\"1822\" height=\"985\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width: 850px) 90vw, 48vw\" srcSet=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75\"/></div><div class=\"art-bottom\"><span class=\"studio-seal\">SIP<br/><small>WEB STUDIO</small></span><p>A polished presence.<br/>A purposeful first impression.</p><span class=\"spark\">✳</span></div></div></section><div class=\"service-strip\"><div class=\"wrap\">Mississippi roots. Digital possibilities.<span>Jackson / Ridgeland / Madison / Flowood / Beyond</span></div></div><section id=\"services\" class=\"section wrap\"><div class=\"section-heading\"><div><p class=\"eyebrow\">What I do</p><h2>Good design.<br/><em>Real purpose.</em></h2></div><p>A website should do more than look the part. It should explain your business, earn trust, and give people a clear next step.</p></div><div class=\"services-grid\"><article><span class=\"eyebrow\">01<!-- --> /</span><h3>Web design &amp; development</h3><p>A custom website that feels like your business. Clear messaging, thoughtful design, and layouts that work beautifully on phones and desktops.</p><a class=\"text-link\" href=\"#contact\">Let’s discuss it ↗</a></article><article><span class=\"eyebrow\">02<!-- --> /</span><h3>Local SEO</h3><p>Help search engines understand what you do and where you work with useful service content, page metadata, and a sound technical foundation.</p><a class=\"text-link\" href=\"#contact\">Let’s discuss it ↗</a></article><article><span class=\"eyebrow\">03<!-- --> /</span><h3>Website care</h3><p>Keep your website current with content updates, software maintenance, backups, and practical support as your business grows.</p><a class=\"text-link\" href=\"#contact\">Let’s discuss it ↗</a></article><article><span class=\"eyebrow\">04<!-- --> /</span><h3>Hosting &amp; performance</h3><p>Fast, secure hosting and performance improvements that make it easier for customers to explore your website and get in touch.</p><a class=\"text-link\" href=\"#contact\">Let’s discuss it ↗</a></article></div></section><section id=\"portfolio\" class=\"work-section section\"><div class=\"wrap\"><div class=\"section-heading\"><div><p class=\"eyebrow\">Selected work / Client project</p><h2>Serious business.<br/><em>Thoughtful presentation.</em></h2></div><p>A closer look at a website built for a Mississippi advisory firm helping business owners navigate important transactions.</p></div><a class=\"project-image\" href=\"/work/magnolia-mergers-acquisitions\"><img alt=\"Featured Magnolia Mergers and Acquisitions web design project\" loading=\"lazy\" width=\"1822\" height=\"985\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width: 1200px) 90vw, 1120px\" srcSet=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmagnolia1.png&amp;w=3840&amp;q=75\"/></a><div class=\"project-caption\"><div><p class=\"eyebrow\">Professional services · Mississippi</p><h3>Magnolia Mergers &amp; Acquisitions</h3><p>Custom website design &amp; development</p></div><a class=\"button\" href=\"/work/magnolia-mergers-acquisitions\">Read the case study ↗</a></div><div class=\"example-showcase\"><div class=\"section-heading\"><div><p class=\"eyebrow\">Explore the examples</p><h2>Local services.<br/><em>Plenty of possibilities.</em></h2></div><p>Three example websites for businesses that keep homes and outdoor spaces at their best. Browse them for inspiration for your own website.</p></div><div class=\"example-grid\"><article class=\"example-card\"><a class=\"example-cover\" href=\"https://southern-shine.thomasmatlockbba.workers.dev/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Explore Southern Shine example website (opens in a new tab)\"><img alt=\"Southern Shine website with a blue exterior cleaning headline and a pressure washing photo\" loading=\"lazy\" width=\"1825\" height=\"988\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width: 750px) 90vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fsouthern-shine-example.png&amp;w=3840&amp;q=75\"/></a><div class=\"example-details\"><p class=\"eyebrow\">Example / <!-- -->Pressure washing</p><h3>Southern Shine</h3><p>A fresh direction for a pressure washing business. Explore the example and imagine your own services in the spotlight.</p><a class=\"text-link\" href=\"https://southern-shine.thomasmatlockbba.workers.dev/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Explore Southern Shine example website (opens in a new tab)\">Explore the example ↗</a></div></article><article class=\"example-card\"><a class=\"example-cover\" href=\"https://magnolia-landscaping.pages.dev/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Explore Magnolia Landscaping example website (opens in a new tab)\"><img alt=\"Magnolia Lawn and Landscape website with green branding and a lawn photograph behind the headline Good things grow here\" loading=\"lazy\" width=\"1836\" height=\"991\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width: 750px) 90vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmagnolia-landscaping-example.png&amp;w=3840&amp;q=75\"/></a><div class=\"example-details\"><p class=\"eyebrow\">Example / <!-- -->Landscaping</p><h3>Magnolia Landscaping</h3><p>An online home for a landscaping business. Take a look at an example built around work that makes a first impression.</p><a class=\"text-link\" href=\"https://magnolia-landscaping.pages.dev/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Explore Magnolia Landscaping example website (opens in a new tab)\">Explore the example ↗</a></div></article><article class=\"example-card\"><a class=\"example-cover\" href=\"https://redclayhandymanservice.pages.dev/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Explore Red Clay Handyman Service example website (opens in a new tab)\"><img alt=\"Red Clay Home Services website with a home repair headline, orange accents, and a handyman working with a saw\" loading=\"lazy\" width=\"1822\" height=\"981\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"(max-width: 750px) 90vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fred-clay-example.png&amp;w=3840&amp;q=75\"/></a><div class=\"example-details\"><p class=\"eyebrow\">Example / <!-- -->Handyman services</p><h3>Red Clay Handyman Service</h3><p>A website direction for a handyman business. See an example of how local services can have a presence worth sharing.</p><a class=\"text-link\" href=\"https://redclayhandymanservice.pages.dev/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Explore Red Clay Handyman Service example website (opens in a new tab)\">Explore the example ↗</a></div></article></div></div></div></section><section id=\"about\" class=\"section wrap about-grid\"><div><p class=\"eyebrow\">Meet your developer</p><h2>A small studio.<br/><em>A personal approach.</em></h2></div><div><p class=\"lead\">Hey, I’m Wes. I’m the developer behind The Sip Web Studio.</p><p>I help Mississippi businesses turn what makes them special into a clear, professional online presence. You work directly with the person designing and building your website, from the first conversation to the finishing touches.</p><p>Whether you’re starting fresh or ready to improve an existing site, we’ll focus on your customers, your goals, and a website you’re proud to put your name on.</p><a class=\"text-link\" href=\"#contact\">Let’s get acquainted ↗</a></div></section><section class=\"quote-section\"><div class=\"wrap\"><p class=\"eyebrow\">From the client</p><blockquote>“This certainly exceeded my expectations, so thank you very much for completing in short order during your busy schedule.”</blockquote><p>Chadwick Word <span>- Magnolia Mergers &amp; Acquisitions</span></p></div></section><section class=\"section wrap\" id=\"process\"><div class=\"section-heading\"><div><p class=\"eyebrow\">How we work</p><h2>From first hello<br/><em>to a confident launch.</em></h2></div><p>Clear steps, direct communication, and a shared understanding of what your website needs to do.</p></div><div class=\"process-grid\"><article><span class=\"eyebrow\">01</span><h3>Listen</h3><p>We talk through your business, your customers, and what you want to accomplish.</p></article><article><span class=\"eyebrow\">02</span><h3>Design &amp; build</h3><p>Your story becomes a thoughtful design, then a responsive, working website.</p></article><article><span class=\"eyebrow\">03</span><h3>Launch &amp; care</h3><p>We review the details together, launch your site, and plan for ongoing support.</p></article></div></section><section id=\"pricing\" class=\"section pricing-section\"><div class=\"wrap\"><div class=\"section-heading\"><div><p class=\"eyebrow\">An investment in your business</p><h2>A good fit.<br/><em>A clear starting point.</em></h2></div><p>Every project is different. These starting prices help you plan; your proposal will reflect the scope we agree on together.</p></div><div class=\"pricing-grid\"><article class=\"\"><p class=\"eyebrow\">Website package</p><h3>Starter</h3><p>A considered first step online.</p><p class=\"price\">$1,500<small>+</small></p><p class=\"small\">Starting price</p><ul><li>Professional website design</li><li>Mobile responsive layouts</li><li>Essential business pages</li><li>Contact form &amp; basic SEO</li></ul><a class=\"button\" href=\"#contact\">Discuss your project ↗</a></article><article class=\"featured\"><p class=\"eyebrow\">For growing businesses</p><h3>Business Growth</h3><p>More room to tell your story.</p><p class=\"price\">$3,000<small>+</small></p><p class=\"small\">Starting price</p><ul><li>Custom design &amp; lead generation</li><li>Expanded SEO setup</li><li>Analytics integration</li><li>Performance optimization</li></ul><a class=\"button\" href=\"#contact\">Discuss your project ↗</a></article><article class=\"\"><p class=\"eyebrow\">Website package</p><h3>Custom</h3><p>Built around your next big idea.</p><p class=\"price\">$5,000<small>+</small></p><p class=\"small\">Starting price</p><ul><li>Custom functionality</li><li>Advanced integrations</li><li>Applications &amp; interactive features</li><li>Scalable architecture</li></ul><a class=\"button\" href=\"#contact\">Discuss your project ↗</a></article></div><div class=\"care-row\"><div><h3>A little care goes a long way.</h3><p>Monthly support: Essential Care $99/month · Growth Care $199/month · SEO Growth $499/month.</p></div><a class=\"text-link\" href=\"#contact\">Find your care plan ↗</a></div></div></section><section class=\"section wrap local-grid\"><div><p class=\"eyebrow\">Made for Mississippi businesses</p><h2>Your web developer<br/>in <em>Jackson, MS.</em></h2><p>Serving Jackson and the surrounding metro, including Ridgeland, Madison, Brandon, Flowood, Pearl, and Clinton. From professional services to local small businesses, I build websites that make your expertise easier to find and understand.</p></div><div class=\"faq\"><h3>A few good questions</h3><details><summary>Can you redesign my existing website?</summary><p>Yes. We can review your current website, keep what serves your business, and improve the design, content, mobile experience, and SEO foundation.</p></details><details><summary>What does SEO setup include?</summary><p>Page titles and descriptions, a clear heading structure, crawlable content, a sitemap, and performance considerations. Ongoing SEO can build on that foundation with useful content and search performance reviews.</p></details><details><summary>Can you guarantee a top Google ranking?</summary><p>No. Search rankings depend on competition, relevance, and many factors beyond a website’s design. I focus on a sound foundation and useful content, with ongoing improvements guided by results.</p></details><details><summary>Do you offer support after launch?</summary><p>Yes. Monthly care plans are available for hosting, maintenance, content updates, and ongoing SEO support depending on the plan.</p></details></div></section><section id=\"contact\" class=\"contact-section section\"><div class=\"wrap contact-grid\"><div><p class=\"eyebrow\">Let’s make something good</p><h2>Your next chapter<br/><em>starts here.</em></h2><p>Tell me a little about your business and what you have in mind. Let’s start with a free consultation.</p><a class=\"text-link email-link\" href=\"mailto:thesipsoftwaresolutions@gmail.com\">thesipsoftwaresolutions@gmail.com ↗</a><p class=\"small\">Serving Jackson, Mississippi &amp; beyond.</p></div><form class=\"contact-form\"><div class=\"form-row\"><label>Your name<input autoComplete=\"name\" required=\"\" placeholder=\"First and last name\" maxLength=\"120\" name=\"name\"/></label><label>Email address<input type=\"email\" autoComplete=\"email\" required=\"\" placeholder=\"you@yourbusiness.com\" maxLength=\"254\" name=\"email\"/></label></div><label>Business name<input autoComplete=\"organization\" required=\"\" placeholder=\"What’s your business called?\" maxLength=\"180\" name=\"business\"/></label><label>What do you have in mind?<textarea name=\"message\" required=\"\" rows=\"4\" placeholder=\"A new website, a fresh look, a little ongoing support…\" maxLength=\"3000\"></textarea></label><button class=\"button\" type=\"submit\">Start the conversation ↗</button><p class=\"small\">This opens a draft in your email app. Send it there to complete your inquiry. You can also email me directly.</p></form></div></section></main><!--$--><!--/$--><footer class=\"wrap footer\"><a class=\"wordmark\" href=\"/\">the sip<span>WEB STUDIO</span></a><p>Thoughtfully built in Mississippi.</p><p>© <!-- -->2026<!-- --> The Sip Web Studio</p></footer><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://thesipwebstudio.com/#studio\",\"name\":\"The Sip Web Studio\",\"url\":\"https://thesipwebstudio.com\",\"email\":\"thesipsoftwaresolutions@gmail.com\",\"areaServed\":[\"Jackson, Mississippi\",\"Ridgeland, Mississippi\",\"Madison, Mississippi\",\"Flowood, Mississippi\",\"Brandon, Mississippi\",\"Pearl, Mississippi\",\"Clinton, Mississippi\"],\"description\":\"Independent web design and development studio serving Jackson and Mississippi businesses.\",\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Website services\",\"itemListElement\":[{\"@type\":\"OfferCatalog\",\"name\":\"Web design and development\"},{\"@type\":\"OfferCatalog\",\"name\":\"Local SEO\"},{\"@type\":\"OfferCatalog\",\"name\":\"Website maintenance\"},{\"@type\":\"OfferCatalog\",\"name\":\"Hosting\"}]}},{\"@type\":\"WebSite\",\"@id\":\"https://thesipwebstudio.com/#website\",\"url\":\"https://thesipwebstudio.com\",\"name\":\"The Sip Web Studio\",\"publisher\":{\"@id\":\"https://thesipwebstudio.com/#studio\"},\"inLanguage\":\"en-US\"}]}</script><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></scrip